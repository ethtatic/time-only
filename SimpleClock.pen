  "themes": {
    "mode": [
      "light",
      "dark"
    ]
  },
  "variables": {
    "color.background": {
      "type": "color",
      "value": [
        {
          "value": "#FAFAFA",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#0F0F0F",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "color.surface": {
      "type": "color",
      "value": [
        {
          "value": "#FFFFFF",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#1A1A1A",
          "theme": {
            "mode": "dark"
          }
        }
      ]
    },
    "color.primary": {
      "type": "color",
      "value": [
        {
          "value": "#1A1A1A",
          "theme": {
            "mode": "light"
          }
        },
        {
          "value": "#F5F5F5",
          "theme": {
            "mode": "dark"
          }

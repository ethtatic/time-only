{
  "version": "2.11",
  "children": [
    {
      "type": "ellipse",
      "id": "separator-dot",
      "x": 1500,
      "y": 245,
      "name": "Separator Dot",
      "reusable": true,
      "fill": "$color.accent",
      "width": 8,
      "height": 8
    },
    {
      "type": "frame",
      "id": "separator-dots",
      "x": 1500,
      "y": 171,
      "name": "Separator Dots",
      "reusable": true,
      "layout": "vertical",
      "gap": 18,
      "justifyContent": "center",
      "alignItems": "center",
      "children": [
        {
          "id": "dot-top",
          "type": "ref",
          "ref": "separator-dot"
        },
        {
          "id": "dot-bottom",
          "type": "ref",
          "ref": "separator-dot"
        }
      ]
    },
    {
      "type": "text",
      "id": "clock-digit",
      "x": 1500,
      "y": 0,
      "name": "Clock Digit",
      "reusable": true,
      "fill": "$color.primary",
      "content": "00",
      "fontFamily": "System",
      "fontSize": 96,
      "fontWeight": "ultralight",
      "letterSpacing": -3.8
    },
    {
      "type": "text",
      "id": "seconds-digit",
      "x": 1500,
      "y": 310,
      "name": "Seconds Digit",
      "reusable": true,
      "fill": "$color.secondary",
      "content": ":00",
      "fontFamily": "System",
      "fontSize": 28,
      "fontWeight": "light"
    },
    {
      "type": "text",
      "id": "date-label",
      "x": 1500,
      "y": 390,
      "name": "Date Label",
      "reusable": true,
      "fill": "$color.secondary",
      "content": "Saturday, 3 May",
      "fontFamily": "System",
      "fontSize": 13,
      "fontWeight": "regular"
    },
    {
      "type": "frame",
      "id": "screen-clock",
      "x": 0,
      "y": 0,
      "name": "Clock Face",
      "theme": {
        "mode": "dark"
      },
      "width": 393,
      "height": 852,
      "fill": "$color.background",
      "layout": "none",
      "children": [
        {
          "type": "frame",
          "id": "clock-display",
          "x": 0,
          "y": 0,
          "name": "Clock Display",
          "width": 393,
          "height": 852,
          "layout": "vertical",
          "gap": 16,
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "time-row",
              "name": "Time Row",
              "layout": "horizontal",
              "gap": 8,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "id": "hours",
                  "type": "ref",
                  "ref": "clock-digit"
                },
                {
                  "id": "separator",
                  "type": "ref",
                  "ref": "separator-dots"
                },
                {
                  "id": "minutes",
                  "type": "ref",
                  "ref": "clock-digit"
                },
                {
                  "id": "seconds",
                  "type": "ref",
                  "ref": "seconds-digit"
                }
              ]
            },
            {
              "id": "date",
              "type": "ref",
              "ref": "date-label"
            }
          ]
        },
        {
          "type": "text",
          "id": "settings-icon",
          "x": 353,
          "y": 792,
          "name": "Settings Icon",
          "fill": "$color.primary",
          "opacity": 0.2,
          "content": "⚙",
          "fontFamily": "System",
          "fontSize": 20
        }
      ]
    },
    {
      "type": "frame",
      "id": "screen-clock-landscape",
      "x": 493,
      "y": 0,
      "name": "Clock Face — Landscape",
      "theme": {
        "mode": "dark"
      },
      "width": 852,
      "height": 393,
      "fill": "$color.background",
      "layout": "none",
      "children": [
        {
          "type": "frame",
          "id": "clock-display-landscape",
          "x": 0,
          "y": 0,
          "name": "Clock Display",
          "width": 852,
          "height": 393,
          "layout": "vertical",
          "gap": 16,
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "time-row-landscape",
              "name": "Time Row",
              "layout": "horizontal",
              "gap": 8,
              "justifyContent": "center",
              "alignItems": "center",
              "children": [
                {
                  "id": "hours-landscape",
                  "type": "ref",
                  "ref": "clock-digit"
                },
                {
                  "id": "separator-landscape",
                  "type": "ref",
                  "ref": "separator-dots"
                },
                {
                  "id": "minutes-landscape",
                  "type": "ref",
                  "ref": "clock-digit"
                },
                {
                  "id": "seconds-landscape",
                  "type": "ref",
                  "ref": "seconds-digit"
                }
              ]
            },
            {
              "id": "date-landscape",
              "type": "ref",
              "ref": "date-label"
            }
          ]
        }
      ]
    },
